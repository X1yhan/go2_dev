Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /TF1
        - /RobotModel1
        - /ColorImage1
        - /DepthImage1
        - /GraspDebug1
        - /GraspTarget1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Alpha: 1
      Collision Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: ColorImage
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/camera/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: DepthImage
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/camera/depth_image
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: CameraPoints
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/camera/points
      Alpha: 1
      Color Transformer: RGB8
      Axis: Z
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 1.5
        Min Value: 0
        Value: true
      Decay Time: 0
      Invert Rainbow: false
      Max Intensity: 255
      Min Intensity: 0
      Point Size: 2
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: GraspDebug
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/visual_grasp/debug_image
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: GraspTarget
      Namespaces:
        visual_grasp: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/visual_grasp/marker
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.9
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 2.4
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  ColorImage:
    collapsed: false
  DepthImage:
    collapsed: false
  GraspDebug:
    collapsed: false
  GraspTarget:
    collapsed: false
  Selection:
    collapsed: true
  Tool Properties:
    collapsed: true
  Views:
    collapsed: true
