<?xml version="1.0" ?>
<!--
  Standalone RM75 arm bench.

  World layout:
    - ground plane at z=0
    - static green table: 0.9 x 0.8 x 0.6 m, top at z=0.6, centred at x=0.08
    - the arm is spawned at (0, 0, 0.6), i.e. on the table top
    - one test object: a 7 cm blue cube sitting on the table.  The task is
      to pick it up with the wrist camera and put it down elsewhere on the
      same table surface.

  The arm model itself is generated by build_arm_model.py --standalone and
  spawned by arm_bench.launch.py.
-->
<sdf version="1.6">
  <world name="arm_bench">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- RGB-D camera rendering -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table: top surface at z=0.6, green so the pick-and-place target
         (the blue cube) is the only blue thing in the world.  Slightly
         deeper than it is wide, which keeps the far side reachable. -->
    <model name="table">
      <static>true</static>
      <pose>0.08 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 0.8 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 0.8 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.06 0.32 0.10 1</ambient>
            <diffuse>0.10 0.52 0.16 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The only graspable object: a 7 cm blue cube.  Model name is used
         as the odometry source and as the detachable-joint child. -->
    <model name="blue_cube">
      <pose>0.210 0.000 0.635 0 0 0</pose>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>blue_cube</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>4.1e-05</ixx>
            <iyy>4.1e-05</iyy>
            <izz>4.1e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.80 1</ambient>
            <diffuse>0.10 0.20 0.95 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
