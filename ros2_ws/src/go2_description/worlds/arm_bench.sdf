<?xml version="1.0" ?>
<!--
  Standalone RM75 arm bench.

  World layout:
    - ground plane at z=0
    - static cube table: 0.6 x 0.6 x 0.6 m, top at z=0.6
    - the arm is spawned at (0, 0, 0.6), i.e. on the table top
    - four colored objects (red ball, blue cube, green cylinder, yellow box)
      sit on the table for multi-object detection and grasping

  The arm model itself is generated by build_arm_model.py --standalone and
  spawned by arm_bench.launch.py.
-->
<sdf version="1.6">
  <world name="arm_bench">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- RGB-D camera rendering -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube table: top surface at z=0.6, centered on the arm base -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.48 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tabletop objects for multi-object visual grasping -->
    <!-- Blue cube, 7 cm; model name is used as the odometry source -->
    <model name="blue_cube">
      <pose>0.26 -0.16 0.635 0 0 0</pose>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>blue_cube</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>4.1e-05</ixx>
            <iyy>4.1e-05</iyy>
            <izz>4.1e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.80 1</ambient>
            <diffuse>0.10 0.20 0.95 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green cylinder, 8 cm diameter x 10 cm, standing upright -->
    <model name="green_cylinder">
      <pose>0.15 0.11 0.65 0 0 0</pose>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>green_cylinder</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>7.4e-05</ixx>
            <iyy>7.4e-05</iyy>
            <izz>4.8e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.04</radius><length>0.10</length></cylinder>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.04</radius><length>0.10</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.70 0.05 1</ambient>
            <diffuse>0.10 0.90 0.10 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow box, 10 x 7.5 x 7 cm; narrow side faces the gripper -->
    <model name="yellow_box">
      <pose>0.25 0.16 0.635 0 0 0</pose>
      <velocity_decay><linear>0.5</linear><angular>0.5</angular></velocity_decay>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>yellow_box</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>4.4e-05</ixx>
            <iyy>6.2e-05</iyy>
            <izz>6.5e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.10 0.075 0.07</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.075 0.07</size></box></geometry>
          <material>
            <ambient>0.70 0.65 0.05 1</ambient>
            <diffuse>0.90 0.85 0.10 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small red ball for simple visual grasping -->
    <model name="target_ball">
      <pose>0.22 0 0.635 0 0 0</pose>
      <!-- The ball is a sphere; stronger damping keeps it from rolling away
           between the vision scan and the grasp. -->
      <velocity_decay><linear>2.0</linear><angular>2.0</angular></velocity_decay>
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>target_ball</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>9.8e-06</ixx>
            <iyy>9.8e-06</iyy>
            <izz>9.8e-06</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.035</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
